# Ignored only on Windows.

# Homebrew config is macOS-only here.
.config/homebrew

# Nothing here reads these. The shells on a Windows host are PowerShell and,
# through scoop's git, Git Bash, which reads .bashrc rather than .zshrc.
.zshrc
.zprofile
.aliases

# Ghostty is macOS-only.
.config/ghostty

# eza is installed here, but its theme is not. On Windows eza reads
# %APPDATA%\eza rather than ~/.config, and only EZA_CONFIG_DIR redirects it,
# which dot_zshrc sets and no shell on a Windows host reads. The vendored theme
# restates eza's compiled-in default, so nothing is lost by skipping it.
.config/eza

# ~/Library is a macOS location. The MacsyZones symlinks under it are the only
# thing in the source tree that targets it.
Library

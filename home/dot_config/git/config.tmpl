[user]
    name = {{ .full_name | quote }}
    email = {{ .email | quote }}

{{ if eq .chezmoi.os "windows" -}}
[core]
    # Git's bundled MSYS ssh cannot reach the 1Password agent on the standard
    # OpenSSH named pipe. Windows OpenSSH can.
    sshCommand = C:/Windows/System32/OpenSSH/ssh.exe

{{ end -}}
# A config hook rather than core.hooksPath, which would replace every repo's own
# hooks and is itself overridden by a repo that sets one, such as Husky. A
# missing gitleaks fails the command and so blocks the commit.
[hook "gitleaks"]
    event = pre-commit
    command = gitleaks git --pre-commit --staged --redact --no-banner

[include]
    path = config-personal

{{ if dig "archipel_academy" "enabled" false . }}
[includeIf "gitdir/i:~/Code/archipelacademy/"]
    path = config-work-archipel-academy
{{ end -}}

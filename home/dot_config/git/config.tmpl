[user]
    name = {{ .full_name | quote }}
    email = {{ .email | quote }}

{{ if eq .chezmoi.os "windows" -}}
[core]
    # Git's bundled MSYS ssh cannot reach the 1Password agent on the standard
    # OpenSSH named pipe. Windows OpenSSH can.
    sshCommand = C:/Windows/System32/OpenSSH/ssh.exe

{{ end -}}
[include]
    path = config-personal

{{ if dig "archipel_academy" "enabled" false . }}
[includeIf "gitdir/i:~/Code/archipelacademy/"]
    path = config-work-archipel-academy
{{ end -}}

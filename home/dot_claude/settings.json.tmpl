{
  "tui": "fullscreen",
  "theme": "auto",
  "includeCoAuthoredBy": false,
  "skipWorkflowUsageWarning": true,
  "cleanupPeriodDays": 365,
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"{{ if eq .chezmoi.os "windows" }},
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"{{ end }}
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Read(.env*)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Edit(.env*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)"
    ]
  }
}

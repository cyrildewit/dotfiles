{
  "tui": "fullscreen",
  "theme": "auto",
  "includeCoAuthoredBy": false,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Read(.env*)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Edit(.env*)",
      "Write(.env*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)"
    ]
  }
}
